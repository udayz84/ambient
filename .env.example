# Copy to .env and fill in. Never commit real secrets.

# --- Strapi CMS ---
NEXT_PUBLIC_STRAPI_URL=http://localhost:1338
STRAPI_URL=http://localhost:1338
STRAPI_TOKEN=

# --- Azure Blob Storage (static asset CDN) ---
# Preferred: Azure AD service principal (Storage Blob Data Contributor)
AZURE_STORAGE_ACCOUNT_NAME=ambientwebasset
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_CONTAINER_NAME=website-assets
# Alternative: connection string auth
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
# Set after upload + verify to serve assets from Azure:
AZURE_ASSETS_PUBLIC_URL=https://ambientwebasset.blob.core.windows.net/website-assets

# --- Mail (SMTP) ---
MAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Mailchimp Marketing API ---
# Used for newsletter subscriptions, contact tagging, and CRM sync.
# Get these from Mailchimp → Account → Extras → API keys and Audience settings.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# --- Cloudflare Turnstile (Privacy-First, Free CAPTCHA) ---
# Sign up with any email (Outlook, work email, etc.) at https://dash.cloudflare.com/
#
# Official testing dummy keys (Always Pass) for local testing:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional: Set to false if you want submissions to fail closed during Cloudflare outages (default: true)
TURNSTILE_FAIL_OPEN=true
# Optional: Set to true if you explicitly want to bypass verification
TURNSTILE_BYPASS=false


