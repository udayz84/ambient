{
  "extends": "@strapi/typescript-utils/tsconfigs/server",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false,
    "inlineSources": false,
    "module": "commonjs",
    "target": "es2021",
    "lib": ["es2021"],
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": ["src", "database", "config"],
  "exclude": ["node_modules", "dist", ".cache", ".tmp", "**/*.test.ts", "src/admin"]
}
