{
  "kind": "collectionType",
  "collectionName": "job_categories",
  "info": {
    "singularName": "job-category",
    "pluralName": "job-categories",
    "displayName": "Job Category",
    "description": "Category for filtering jobs"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "jobs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job.job",
      "mappedBy": "category"
    }
  }
}
