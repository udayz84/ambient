      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "fields": {
      "type": "component",
      "repeatable": true,
      "component": "form.field"
    },
    "cta_label": {
      "type": "string",
      "default": "Submit & Download"
    },
    "success_title": {
      "type": "string"
    },
    "success_text": {
      "type": "text"
    }
