{
  "kind": "collectionType",
  "collectionName": "redirects",
  "info": {
    "singularName": "redirect",
    "pluralName": "redirects",
    "displayName": "Redirect",
    "description": "URL redirect management — maps old URLs to new URLs with configurable HTTP status codes"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "old_url": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 2048
    },
    "new_url": {
      "type": "string",
      "required": true,
      "maxLength": 2048
    },
    "status_code": {
      "type": "string",
      "default": "301",
      "required": true
    }
  }
}
