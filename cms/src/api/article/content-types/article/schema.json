{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "News, resources, blog posts, press releases, and events unified collection"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "news",
        "resource"
      ],
      "default": "news",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "blog",
        "press_release",
        "product_update",
        "event",
        "webinar",
        "whitepaper",
        "case_study",
        "video",
        "podcast",
        "technical_insight",
        "partnership"
      ],
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "body": {
      "type": "customField",
      "options": {
        "preset": "defaultHtml"
      },
      "customField": "plugin::ckeditor5.CKEditor"
    },
    "featured_image": {
      "type": "media",
      "multiple": false
    },
    "hero_image": {
      "type": "media",
      "multiple": false
    },
    "alt": {
      "type": "string"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "external_url": {
      "type": "string",
      "maxLength": 500
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "show_on_homepage": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}