{
  "collectionName": "components_resources_featured_cards",
  "info": {
    "displayName": "Featured Card",
    "description": "Featured resource card"
  },
  "options": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "image_alt": {
      "type": "string"
    },
    "badge_label": {
      "type": "string",
      "default": "WHITEPAPER"
    },
    "badge_variant": {
      "type": "enumeration",
      "enum": [
        "white",
        "stacked"
      ],
      "default": "white"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "cta_label": {
      "type": "string",
      "default": "Download PDF"
    },
    "cta_href": {
      "type": "string"
    },
    "pdf_file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "pdf_file_alt": {
      "type": "string"
    },
    "enable_download_popup": {
      "type": "boolean",
      "default": false
    }
  }
}
