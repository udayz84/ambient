{
  "collectionName": "components_shared_seo",
  "info": {
    "displayName": "SEO",
    "description": "Per-page SEO metadata. Leave empty to use Global defaults."
  },
  "options": {},
  "attributes": {
    "meta_title": {
      "type": "string",
      "maxLength": 60
    },
    "meta_description": {
      "type": "text",
      "maxLength": 160
    },
    "og_image": {
      "type": "media",
      "multiple": false
    },
    "keywords": {
      "type": "text"
    },
    "noindex": {
      "type": "boolean",
      "default": false
    },
    "canonical_url": {
      "type": "string"
    }
  }
}
