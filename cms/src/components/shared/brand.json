{
  "collectionName": "components_shared_brands",
  "info": {
    "displayName": "Brand",
    "description": "Site brand identity"
  },
  "options": {},
  "attributes": {
    "site_name": {
      "type": "string",
      "required": true,
      "default": "Ambient Scientific",
      "maxLength": 100
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "description": "Navbar logo shown at 135×38. Recommended: SVG (or 280×80 px PNG)."
    },
    "logo_alt": {
      "type": "string"
    },
    "logo_mobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "description": "Not yet shown on the site — mobile menus reuse the main logo."
    },
    "logo_mobile_alt": {
      "type": "string"
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "description": "Not wired to the site yet. Recommended: 32×32 px PNG/ICO (16/32/48 sizes)."
    },
    "favicon_alt": {
      "type": "string"
    }
  }
}
