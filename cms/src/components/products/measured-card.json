{
  "collectionName": "components_products_measured_cards",
  "info": {
    "displayName": "Measured Card",
    "description": "Measured section spec card (chip image + stat rows)"
  },
  "options": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "gpx10",
        "risc_mcu",
        "mcu_npu"
      ],
      "default": "gpx10",
      "required": true
    },
    "chip_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "description": "Chip render shown at 401×255, cover. Recommended: 800×510 px WebP/PNG."
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "products.measured-stat"
    }
  }
}
